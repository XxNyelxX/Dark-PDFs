{
    "manifest_version": 3,
    "name": "Dark-PDFs",
    "version": "1.3",
    "description": "Integrated dark mode for the PDF viewer.",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>",
        "file:///*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src * blob: data: file:;"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
    }
}